<div class="card card-info card-outline">
	<div class="card-header">
		<h5 class="m-0">In-Game Commands</h5>
	</div>
	<div class="card-body">
		<table class="table table-bordered table-striped">
			<thead>
				<tr>
					<th>Words</th>
					<th>Description</th>
					<th>Group</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
			{% for cmd in commands %}
				<tr>
					<td><code>{{ cmd.words }}</code></td>
					<td>{{ cmd.description }}</td>
					<td>{{ cmd.group_type }}</td>
					<td>
						<a href="{{ constant('ADMIN_URL') }}?p=commands_edit&id={{ cmd.id }}" class="btn btn-success btn-sm" title="Edit">
							<i class="fas fa-pencil-alt"></i>
						</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">No commands found.</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	</div>
</div>